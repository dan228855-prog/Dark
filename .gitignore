# Unreal Engine — генерируемое, в git не нужно
Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Плагины: собранное тоже не храним
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Исходники скачанных ассетов (архивы, raw-файлы до импорта) — держать вне репозитория
/RawAssets/
*.zip
*.rar
*.7z

# Content пока не храним в git (6+ ГБ, ассеты маркетплейса; нужен Git LFS).
# Исключение — текстовые строки локализации (String Table из CSV), они нужны коду.
/Content/*
!/Content/Localization/

# Скачанные плагины апскейлеров (DLSS/FSR/Streamline, ~2.4 ГБ) — ставятся заново по docs, в git не храним
/Plugins/DLSS/
/Plugins/FSR/
/Plugins/Streamline*/
# Исходники моделей (как RawAssets)
/SourceArt/
